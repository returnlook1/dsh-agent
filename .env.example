# DSH Agent Service —— 环境变量示例
# 复制为 .env 并按需修改；服务本身不自动加载 .env，部署时请用进程管理器注入。

# ------------------------------------------------------------------ HTTP 服务
PORT=8787
HOST=127.0.0.1

# --------------------------------------------------------------- 数据与运行时
DATA_DIR=./data
RUNTIME_DIR=./runtime
WEB_DIST=./apps/web/dist

# ----------------------------------------------------------------- 能力清单
# 技能根目录（逗号分隔），目录 bundle（<name>/SKILL.md）或单文件（<name>.md）
SKILLS_DIRS=./runtime/skills
# MCP 服务器定义
MCP_CONFIG=./config/mcp-servers.json
# 业务工具演示数据（会被复制进每个运行时快照）
AGENT_SERVICE_TOOLS_DATA_DIR=./runtime/tools

# ------------------------------------------------------------------ DSH 运行时
# 运行时 profile 名（不要沿用宿主的 DSH_PROFILE，DSH Desktop 会把它设为 desktop）
AGENT_SERVICE_DSH_PROFILE=agent-service
# DSH CLI 入口（默认取仓库内 node_modules 的安装位置）
# DSH_BIN=./node_modules/@deepseek-ai/dsh/lib/bin.js
# 空闲运行时回收（毫秒）；回收后同配置下次自动 resume
RUNTIME_IDLE_MS=300000
# 单轮上限（毫秒）
TURN_TIMEOUT_MS=600000
# 同时存在的运行时上限
MAX_RUNTIMES=8

# ----------------------------------------------------------------- 模型与凭据
# 凭据只注入 DSH 子进程环境，不写入磁盘
DEEPSEEK_API_KEY=
# 指向私有网关或本地 mock；留空表示直连官方端点
# DEEPSEEK_BASE_URL=http://127.0.0.1:8899/v1
# 离线演示时设为 1（配合 npm run mock:llm）
# MOCK_LLM=1
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-flash

# --------------------------------------------------------------- 内网访问控制
# 设置后所有 /api/* 要求 Authorization: Bearer <token>（共享密钥，不是用户体系）
# INTERNAL_TOKEN=
# 允许的前端来源（逗号分隔）；留空 = 只允许同源
# CORS_ORIGINS=http://127.0.0.1:5173

# ------------------------------------------------------------------- 日志
LOG_LEVEL=info
