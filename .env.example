# Agent Studio —— 环境变量示例
# 复制为 .env 并按需修改；网关本身不自动加载 .env，部署时请用进程管理器注入。

# ------------------------------------------------------------------ HTTP 服务
PORT=8787
HOST=127.0.0.1

# --------------------------------------------------------------- 数据与运行时
DATA_DIR=./data
RUNTIME_DIR=./runtime
WEB_DIST=./apps/web/dist

# ------------------------------------------------------------------ DSH 运行时
# 受限 profile 名（不要沿用宿主的 DSH_PROFILE，DSH Desktop 会把它设为 desktop）
AGENT_STUDIO_DSH_PROFILE=studio
# DSH CLI 入口（默认取仓库内 node_modules 的安装位置）
# DSH_BIN=./node_modules/@deepseek-ai/dsh/lib/bin.js

# ----------------------------------------------------------------- 模型与凭据
# 凭据只注入 DSH 子进程环境，不写入磁盘
DEEPSEEK_API_KEY=
# 指向私有网关或本地 mock；留空表示直连官方端点
# DEEPSEEK_BASE_URL=http://127.0.0.1:8899/v1
# 离线演示时设为 1（配合 npm run mock:llm）
# MOCK_LLM=1
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-flash

# ------------------------------------------------------------------- 认证
# 不设置时网关会在 DATA_DIR/.auth-secret 自动生成
# AUTH_SECRET=
TOKEN_TTL_HOURS=12

# ------------------------------------------------------------------- 运行时限额
RUNTIME_IDLE_MS=600000
APPROVAL_TIMEOUT_MS=120000

# ------------------------------------------------------------------- 日志
LOG_LEVEL=info
