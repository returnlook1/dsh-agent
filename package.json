{
  "name": "agent-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH Agent Service —— 可配置 Skills 与 MCP 的 Agent 对话服务（Fastify + Vue Playground + DSH Runtime）",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build:shared && npm run build:plugins && npm run build:gateway && npm run build:web",
    "build:shared": "npm run build -w @agent-studio/shared",
    "build:plugins": "npm run build -w @agent-studio/plugin-agent-tools",
    "build:gateway": "npm run build -w @agent-studio/gateway",
    "build:web": "npm run build -w @agent-studio/web",
    "dev": "npm run dev -w @agent-studio/gateway",
    "dev:web": "npm run dev -w @agent-studio/web",
    "start": "node apps/gateway/dist/server.js",
    "typecheck": "npm run typecheck -w @agent-studio/shared && npm run typecheck -w @agent-studio/plugin-agent-tools && npm run typecheck -w @agent-studio/gateway && npm run typecheck -w @agent-studio/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:demo": "node scripts/gen-demo-data.mjs",
    "mock:llm": "node scripts/mock-llm-server.mjs",
    "demo": "node scripts/demo.mjs",
    "mcp:demo": "node scripts/mcp-data-center-server.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "e2e": "node scripts/e2e-service.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:runtime && npm run e2e"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-mock-server": "0.2.1-rc.3",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "protobufjs"
    ]
  }
}
