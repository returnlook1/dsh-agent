# The DSH packages ship peer dependencies that are provided by the runtime tree,
# and the workspace links sibling packages by name.
strict-peer-dependencies=false
auto-install-peers=true
# 本仓库统一使用 npm workspaces（原因见 docs/DECISIONS.md §1）。
# pnpm-workspace.yaml 仍然保留，便于在 Windows junction 之外的环境改用 pnpm。
